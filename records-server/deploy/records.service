[Unit]
Description=Records server
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/ravvss/records
Environment="PATH=/home/ravvss/.local/node/bin:/home/ravvss/.local/share/pnpm:/usr/local/bin:/usr/bin:/bin"
Environment=NODE_ENV=production
Environment=PORT=4320
Environment=RECORDS_DATABASE_PATH=/srv/records/records.sqlite
Environment=RECORDS_WEB_ROOT=/home/ravvss/records/dist/web
ExecStart=/home/ravvss/.local/node/bin/node dist/src/server.js
Restart=on-failure
RestartSec=3s
KillSignal=SIGTERM
TimeoutStopSec=30s
UMask=0077

[Install]
WantedBy=default.target
